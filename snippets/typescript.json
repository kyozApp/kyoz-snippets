{
	"Remote Form Function": {
		"prefix": "kyoz-ts-sv-remote-form",
		"body": [
			"import { form } from \"\\$app/server\";",
			"",
			"import { db } from \"#lib/server/db\";",
			"import {",
			"\t${1:entity}CreateSchema,",
			"} from \"#lib/validations/${2:entity}/${2:entity}.form.validation\";",
			"",
			"import { get${3:Entity}List } from \"./${2:entity}.query.remote\";",
			"",
			"/**",
			" * ${4:Registra un nuevo registro en el sistema.}",
			" */",
			"export const create${3:Entity} = form(${1:entity}CreateSchema.body, async (data) => {",
			"\t// 1. Validar reglas de negocio",
			"\t${5}",
			"",
			"\t// 2. Guardar en base de datos",
			"\tawait db.orm.public.${3:Entity}.create({",
			"\t\t$0",
			"\t});",
			"",
			"\t// 3. Refrescar listado",
			"\tvoid get${3:Entity}List().refresh();",
			"});"
		],
		"description": "Función Remote Form con $app/server, base de datos y refresco de caché"
	},
	"Remote Command Function": {
		"prefix": "kyoz-ts-sv-remote-command",
		"body": [
			"import { error } from \"@sveltejs/kit\";",
			"import { command } from \"\\$app/server\";",
			"",
			"import { db } from \"#lib/server/db\";",
			"import { ${1:entity}${2:Action}Schema } from \"#lib/validations/${3:entity}/${3:entity}.command.validation\";",
			"",
			"import { get${4:Entity}Details, get${4:Entity}List } from \"./${3:entity}.query.remote\";",
			"",
			"/**",
			" * ${5:Ejecuta una acción o mutación en el sistema.}",
			" */",
			"export const ${6:action}${4:Entity} = command(",
			"\t${1:entity}${2:Action}Schema.body,",
			"\tasync (data) => {",
			"\t\t// 1. Validar existencia del registro",
			"\t\tconst existing = await db.orm.public.${4:Entity}.where({ id: data.id }).first();",
			"\t\tif (!existing) {",
			"\t\t\terror(404, \"El registro no se encontró.\");",
			"\t\t}",
			"",
			"\t\t// 2. Ejecutar mutación",
			"\t\tawait db.orm.public.${4:Entity}.where({ id: data.id }).update({",
			"\t\t\t$0",
			"\t\t});",
			"",
			"\t\t// 3. Refrescar datos y caché",
			"\t\tvoid get${4:Entity}List().refresh();",
			"\t\tvoid get${4:Entity}Details({ id: data.id }).refresh();",
			"\t},",
			");"
		],
		"description": "Función Remote Command con validación de existencia, mutación y refresco de caché"
	},
	"Remote Query Function": {
		"prefix": "kyoz-ts-sv-remote-query",
		"body": [
			"import { error } from \"@sveltejs/kit\";",
			"import { query } from \"\\$app/server\";",
			"",
			"import * as v from \"valibot\";",
			"",
			"import { db } from \"#lib/server/db\";",
			"import {",
			"\t${1:entity}DetailSchema,",
			"\t${1:entity}ListSchema,",
			"} from \"#lib/validations/${2:entity}/${2:entity}.query.validation\";",
			"",
			"/**",
			" * Obtiene el listado general de ${1:entity}.",
			" */",
			"export const get${3:Entity}List = query(async () => {",
			"\tconst items = await db.orm.public.${3:Entity}.select(",
			"\t\t\"id\",",
			"\t\t\"createdAt\",",
			"\t\t\"updatedAt\",",
			"\t)",
			"\t\t.orderBy((t) => t.createdAt.desc())",
			"\t\t.all();",
			"",
			"\treturn v.parse(${1:entity}ListSchema.response, items);",
			"});",
			"",
			"/**",
			" * Obtiene el detalle de un(a) ${1:entity} por ID.",
			" */",
			"export const get${3:Entity}Details = query(${1:entity}DetailSchema.params, async (data) => {",
			"\tconst item = await db.orm.public.${3:Entity}.where({ id: data.id })",
			"\t\t.select(",
			"\t\t\t\"id\",",
			"\t\t\t\"createdAt\",",
			"\t\t\t\"updatedAt\",",
			"\t\t)",
			"\t\t.first();",
			"",
			"\tif (!item) {",
			"\t\terror(404, \"El registro no se encontró.\");",
			"\t}",
			"",
			"\treturn v.parse(${1:entity}DetailSchema.response, item);",
			"});"
		],
		"description": "Funciones Remote Query (listado y detalle) validadas con Valibot"
	},
	"Valibot Form Validation": {
		"prefix": "kyoz-ts-sv-validation-form",
		"body": [
			"import * as v from \"valibot\";",
			"",
			"/**",
			" * Crear ${1:entidad}",
			" */",
			"export const ${2:entity}CreateSchema = {",
			"\tbody: v.object({",
			"\t\t${3:name}: v.pipe(",
			"\t\t\tv.string(\"El campo no es válido.\"),",
			"\t\t\tv.trim(),",
			"\t\t\tv.minLength(1, \"El campo es obligatorio.\"),",
			"\t\t),",
			"\t\t$0",
			"\t}),",
			"};",
			"",
			"export type ${4:Entity}CreateBody = v.InferOutput<typeof ${2:entity}CreateSchema.body>;",
			"",
			"/**",
			" * Actualizar ${1:entidad}",
			" */",
			"export const ${2:entity}UpdateSchema = {",
			"\tbody: v.object({",
			"\t\tid: v.pipe(",
			"\t\t\tv.string(\"El ID no es válido.\"),",
			"\t\t\tv.uuid(\"El ID no es un UUID válido.\"),",
			"\t\t),",
			"\t\t${3:name}: v.pipe(",
			"\t\t\tv.string(\"El campo no es válido.\"),",
			"\t\t\tv.trim(),",
			"\t\t\tv.minLength(1, \"El campo es obligatorio.\"),",
			"\t\t),",
			"\t}),",
			"};",
			"",
			"export type ${4:Entity}UpdateBody = v.InferOutput<typeof ${2:entity}UpdateSchema.body>;"
		],
		"description": "Esquemas de validación Valibot para formulario (Create y Update) con tipos InferOutput"
	},
	"Valibot Command Validation": {
		"prefix": "kyoz-ts-sv-validation-command",
		"body": [
			"import * as v from \"valibot\";",
			"",
			"/**",
			" * ${1:Acción sobre la entidad}",
			" */",
			"export const ${2:entity}${3:Action}Schema = {",
			"\tbody: v.object({",
			"\t\tid: v.pipe(",
			"\t\t\tv.string(\"El ID es obligatorio y debe ser un string.\"),",
			"\t\t\tv.uuid(\"El ID no es un UUID válido.\"),",
			"\t\t),",
			"\t\t${4:isActive}: v.boolean(),",
			"\t\t$0",
			"\t}),",
			"};",
			"",
			"export type ${5:Entity}${3:Action}Body = v.InferOutput<",
			"\ttypeof ${2:entity}${3:Action}Schema.body",
			">;"
		],
		"description": "Esquema de validación Valibot para Remote Command con tipo InferOutput"
	},
	"Valibot Query Validation": {
		"prefix": "kyoz-ts-sv-validation-query",
		"body": [
			"import * as v from \"valibot\";",
			"",
			"/**",
			" * Listar ${1:entidades}",
			" */",
			"export const ${2:entity}ListSchema = {",
			"\tresponse: v.array(",
			"\t\tv.pipe(",
			"\t\t\tv.object({",
			"\t\t\t\tid: v.pipe(v.string(), v.uuid()),",
			"\t\t\t\t${3:name}: v.string(),",
			"\t\t\t\tcreatedAt: v.pipe(v.string(), v.isoTimestamp()),",
			"\t\t\t\tupdatedAt: v.pipe(v.string(), v.isoTimestamp()),",
			"\t\t\t}),",
			"\t\t\tv.readonly(),",
			"\t\t),",
			"\t),",
			"};",
			"",
			"export type ${4:Entity}ListItemResponse = v.InferOutput<",
			"\ttypeof ${2:entity}ListSchema.response",
			">[number];",
			"",
			"/**",
			" * Detalles de ${1:entidad}",
			" */",
			"export const ${2:entity}DetailSchema = {",
			"\tparams: v.object({",
			"\t\tid: v.pipe(v.string(), v.uuid()),",
			"\t}),",
			"\tresponse: v.pipe(",
			"\t\tv.object({",
			"\t\t\tid: v.pipe(v.string(), v.uuid()),",
			"\t\t\t${3:name}: v.string(),",
			"\t\t\tcreatedAt: v.pipe(v.string(), v.isoTimestamp()),",
			"\t\t\tupdatedAt: v.pipe(v.string(), v.isoTimestamp()),",
			"\t\t}),",
			"\t\tv.readonly(),",
			"\t),",
			"};",
			"",
			"export type ${4:Entity}DetailParams = v.InferOutput<typeof ${2:entity}DetailSchema.params>;",
			"export type ${4:Entity}DetailResponse = v.InferOutput<",
			"\ttypeof ${2:entity}DetailSchema.response",
			">;"
		],
		"description": "Esquemas de validación Valibot para List y Detail Query con tipos InferOutput"
	}
}
