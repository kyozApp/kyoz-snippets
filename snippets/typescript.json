			"\t\t\tisActive: v.boolean(),",
			"\t\t\tcreatedAt: v.pipe(v.string(), v.isoTimestamp()),",
			"\t\t\tupdatedAt: v.pipe(v.string(), v.isoTimestamp()),",
			"\t\t}),",
			"\t\tv.readonly(),",
			"\t),",
