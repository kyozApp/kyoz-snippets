	"[Prisma 8] Base Contract": {
		"prefix": "kyoz-prisma-contract",
		"body": [
			"import {",
			"\tdefineContract,",
			"\tnativeEnum,",
			"\tpg,",
			"} from \"@prisma/orm-postgres/contract-builder\";",
			"",
			"export const contract = defineContract({}, ({ field, model, rel }) => {",
			"\t// ─── Enums ──────────────────────────────────────────────────────────",
			"\tconst Role = nativeEnum(\"Role\", ${1:\"ADMIN\", \"USER\"});",
			"",
			"\t// ─── Modelos Core ───────────────────────────────────────────────────",
			"\tconst User = model(\"User\", {",
			"\t\tfields: {",
			"\t\t\tid: field.id.uuidv7Native(),",
			"\t\t\tname: field.text(),",
			"\t\t\tusername: field.text().unique(),",
			"\t\t\temail: field.text().unique(),",
			"\t\t\tpassword: field.text(),",
			"\t\t\trole: field.column(pg.enum(Role)).default(\"${2:USER}\"),",
			"\t\t\tisActive: field.boolean().default(true),",
			"\t\t\tcreatedAt: field.temporal.createdAtString(),",
			"\t\t\tupdatedAt: field.temporal.updatedAtString(),",
			"\t\t},",
			"\t});",
			"",
			"\tconst Session = model(\"Session\", {",
			"\t\tfields: {",
			"\t\t\tid: field.id.uuidv7Native(),",
			"\t\t\tuserId: field.uuidNative(),",
			"\t\t\texpiresAt: field.temporal.timestamptzString(),",
			"\t\t\tcreatedAt: field.temporal.createdAtString(),",
			"\t\t\tupdatedAt: field.temporal.updatedAtString(),",
			"\t\t},",
			"\t});",
			"",
			"\t$0",
			"",
			"\treturn {",
			"\t\tmodels: {",
			"\t\t\tUser: User.relations({",
			"\t\t\t\tsessions: rel.hasMany(Session, { by: \"userId\" }),",
			"\t\t\t}),",
			"\t\t\tSession: Session.relations({",
			"\t\t\t\tuser: rel.belongsTo(User, { from: \"userId\", to: \"id\" }),",
			"\t\t\t}),",
			"\t\t},",
			"\t};",
			"});",
			"",
			"export default contract;"
		],
		"description": [
			"[src/prisma/contract.ts] Contrato de Modelos y Relaciones Prisma 8",
			"- Modelos nativos PostgreSQL (UUIDv7, timestamps, enums y relaciones)"
		]
	},
