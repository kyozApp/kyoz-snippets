{
	"[SvelteKit] Remote Form Function": {
		"prefix": "kyoz-sv-remote-form",
		"body": [
			"import { form } from \"\\$app/server\";",
			"",
			"import { db } from \"#lib/server/db\";",
			"import {",
			"\t${1:entity}CreateSchema,",
			"\t${1:entity}UpdateSchema,",
			"} from \"#lib/validations/${2:entity}/${2:entity}.form.validation\";",
			"",
			"import {",
			"\tget${3:Entity}Details,",
			"\tget${3:Entity}List,",
			"} from \"./${2:entity}.query.remote\";",
			"",
			"/**",
			" * Registra un(a) nuevo(a) ${1:entity} en el sistema.",
			" */",
			"export const create${3:Entity} = form(${1:entity}CreateSchema.body, async (data) => {",
			"\t// 1. Validar reglas de negocio",
			"\t$0",
			"",
			"\t// 2. Guardar en base de datos",
			"\tawait db.orm.public.${3:Entity}.create({",
			"\t\tname: data.name,",
			"\t});",
			"",
			"\t// 3. Refrescar listado reactivo",
			"\tvoid get${3:Entity}List().refresh();",
			"});",
			"",
			"/**",
			" * Actualiza los datos de un(a) ${1:entity} existente.",
			" */",
			"export const update${3:Entity} = form(${1:entity}UpdateSchema.body, async (data) => {",
			"\t// 1. Validar existencia del registro",
			"\tconst existing = await db.orm.public.${3:Entity}.where({ id: data.id }).first();",
			"\tif (!existing) {",
			"\t\treturn {",
			"\t\t\tsuccess: false,",
			"\t\t\terror: \"El registro no se encontró en el sistema.\",",
			"\t\t};",
			"\t}",
			"",
			"\t// 2. Actualizar en base de datos",
			"\tawait db.orm.public.${3:Entity}.where({ id: data.id }).update({",
			"\t\tname: data.name,",
			"\t});",
			"",
			"\t// 3. Refrescar caché y consultas reactivas",
			"\tvoid get${3:Entity}List().refresh();",
			"\tvoid get${3:Entity}Details({ id: data.id }).refresh();",
			"});"
		],
		"description": [
			"[src/lib/remote/.../*.form.remote.ts] Remote Form ($app/server)",
			"- Funciones create y update con base de datos, validación Valibot y refresco reactivo",
			"- Se conecta con: *.form.validation.ts y cliente DB (Prisma)"
		]
	},
	"[SvelteKit] Remote Command Function": {
		"prefix": "kyoz-sv-remote-command",
		"body": [
			"import { error } from \"@sveltejs/kit\";",
			"import { command } from \"\\$app/server\";",
			"",
			"import { db } from \"#lib/server/db\";",
			"import { ${1:entity}${2:Action}Schema } from \"#lib/validations/${3:entity}/${3:entity}.command.validation\";",
			"",
			"import { get${4:Entity}Details, get${4:Entity}List } from \"./${3:entity}.query.remote\";",
			"",
			"/**",
			" * ${5:Ejecuta una acción o mutación en el sistema.}",
			" */",
			"export const ${6:action}${4:Entity} = command(",
			"\t${1:entity}${2:Action}Schema.body,",
			"\tasync (data) => {",
			"\t\t// 1. Validar existencia del registro",
			"\t\tconst existing = await db.orm.public.${4:Entity}.where({ id: data.id }).first();",
			"\t\tif (!existing) {",
			"\t\t\terror(404, \"El registro no se encontró.\");",
			"\t\t}",
			"",
			"\t\t// 2. Ejecutar mutación",
			"\t\tawait db.orm.public.${4:Entity}.where({ id: data.id }).update({",
			"\t\t\t$0",
			"\t\t});",
			"",
			"\t\t// 3. Refrescar datos y caché",
			"\t\tvoid get${4:Entity}List().refresh();",
			"\t\tvoid get${4:Entity}Details({ id: data.id }).refresh();",
			"\t},",
			");"
		],
		"description": [
			"[src/lib/remote/.../*.command.remote.ts] Remote Command ($app/server)",
			"- Ejecución de acciones/mutaciones en backend con refresco de queries",
			"- Se conecta con: *.command.validation.ts y cliente DB (Prisma)"
		]
	},
	"[SvelteKit] Remote Query Function": {
		"prefix": "kyoz-sv-remote-query",
		"body": [
			"import { error } from \"@sveltejs/kit\";",
			"import { query } from \"\\$app/server\";",
			"",
			"import * as v from \"valibot\";",
			"",
			"import { db } from \"#lib/server/db\";",
			"import {",
			"\t${1:entity}DetailSchema,",
			"\t${1:entity}ListSchema,",
			"} from \"#lib/validations/${2:entity}/${2:entity}.query.validation\";",
			"",
			"/**",
			" * Obtiene el listado general de ${1:entity}.",
			" */",
			"export const get${3:Entity}List = query(async () => {",
			"\tconst items = await db.orm.public.${3:Entity}.select(",
			"\t\t\"id\",",
			"\t\t\"createdAt\",",
			"\t\t\"updatedAt\",",
			"\t)",
			"\t\t.orderBy((t) => t.createdAt.desc())",
			"\t\t.all();",
			"",
			"\treturn v.parse(${1:entity}ListSchema.response, items);",
			"});",
			"",
			"/**",
			" * Obtiene el detalle de un(a) ${1:entity} por ID.",
			" */",
			"export const get${3:Entity}Details = query(${1:entity}DetailSchema.params, async (data) => {",
			"\tconst item = await db.orm.public.${3:Entity}.where({ id: data.id })",
			"\t\t.select(",
			"\t\t\t\"id\",",
			"\t\t\t\"createdAt\",",
			"\t\t\t\"updatedAt\",",
			"\t\t)",
			"\t\t.first();",
			"",
			"\tif (!item) {",
			"\t\terror(404, \"El registro no se encontró.\");",
			"\t}",
			"",
			"\treturn v.parse(${1:entity}DetailSchema.response, item);",
			"});"
		],
		"description": [
			"[src/lib/remote/.../*.query.remote.ts] Remote Query ($app/server)",
			"- Consultas tipadas de listado y detalle con validación de salida",
			"- Se conecta con: *.query.validation.ts y cliente DB (Prisma)"
		]
	},
	"[Valibot] Form Validation Schema": {
