	"[SvelteKit] Environment Variables Validation": {
		"prefix": "kyoz-sv-env",
		"body": [
			"import { defineEnvVars } from \"@sveltejs/kit/env\";",
			"",
			"import * as v from \"valibot\";",
			"",
			"/**",
			" * Definición y validación de variables de entorno de la aplicación.",
			" *",
			" * Propiedades configurables por variable:",
			" * - public: Si es `true`, se expone al cliente (\\$app/env/public). Si es `false`, solo vive en el servidor (\\$app/env/private).",
			" * - static: Si es `true`, su valor se incrusta en compilación (build time). Si es `false`, se lee dinámicamente al arrancar (runtime).",
			" * - description: Documentación que muestra el IDE al pasar el cursor sobre la variable.",
			" * - schema: Esquema de validación y tipado de Valibot que se comprueba al iniciar la aplicación.",
			" */",
			"export const variables = defineEnvVars({",
			"\t/**",
			"\t * Variables de entorno Privadas (solo servidor)",
			"\t */",
			"\tPORT: {",
			"\t\tpublic: false,",
			"\t\tstatic: false,",
			"\t\tdescription: \"Puerto de ejecución del servidor\",",
			"\t\tschema: v.pipe(v.string(), v.toNumber(), v.number()),",
			"\t},",
			"\tORIGIN: {",
			"\t\tpublic: false,",
			"\t\tstatic: false,",
			"\t\tdescription: \"Origen URL base de la aplicación\",",
			"\t\tschema: v.pipe(v.string(), v.url()),",
			"\t},",
			"\tDATABASE_URL: {",
			"\t\tpublic: false,",
			"\t\tstatic: false,",
			"\t\tdescription: \"Cadena de conexión a PostgreSQL para Prisma ORM\",",
			"\t\tschema: v.pipe(",
			"\t\t\tv.string(),",
			"\t\t\tv.nonEmpty(\"DATABASE_URL es requerida y no puede estar vacía\"),",
			"\t\t),",
			"\t},",
			"",
			"\t/**",
			"\t * Variables de entorno Públicas (cliente y servidor)",
			"\t */",
			"\t${1:PUBLIC_API_URL}: {",
			"\t\tpublic: true,",
			"\t\tstatic: true,",
			"\t\tdescription: \"${2:URL base de la API pública}\",",
			"\t\tschema: v.pipe(v.string(), v.url()),",
			"\t},",
			"\t$0",
			"});"
		],
		"description": [
			"[src/env.ts] Variables de Entorno Validadas con Valibot",
			"- Variables estáticas/dinámicas públicas y privadas con defineEnvVars"
		]
	},
	"[SvelteKit] Vite Configuration": {
		"prefix": "kyoz-sv-vite",
		"body": [
			"import adapter from \"@sveltejs/adapter-node\";",
			"import { sveltekit } from \"@sveltejs/kit/vite\";",
			"",
			"import { paraglideVitePlugin } from \"@inlang/paraglide-js\";",
			"import tailwindcss from \"@tailwindcss/vite\";",
			"import { defineConfig, loadEnv } from \"vite\";",
			"",
			"export default defineConfig(({ mode }) => {",
			"\tconst env = loadEnv(mode, process.cwd(), \"\");",
			"\tconst port = Number(env.PORT) || 5173;",
			"",
			"\treturn {",
			"\t\tserver: { port, host: true },",
			"\t\tpreview: { port, host: true },",
			"\t\tplugins: [",
			"\t\t\ttailwindcss(),",
			"\t\t\tsveltekit({",
			"\t\t\t\talias: { \"#lib\": \"src/lib/index.js\", \"#lib/*\": \"src/lib/*\" },",
			"\t\t\t\texperimental: {",
			"\t\t\t\t\texplicitEnvironmentVariables: true,",
			"\t\t\t\t\tremoteFunctions: true,",
			"\t\t\t\t},",
			"\t\t\t\tcompilerOptions: {",
			"\t\t\t\t\texperimental: { async: true },",
			"\t\t\t\t\trunes: ({ filename }) =>",
			"\t\t\t\t\t\tfilename.split(/[/\\\\]/).includes(\"node_modules\") ? undefined : true,",
			"\t\t\t\t},",
			"\t\t\t\tadapter: adapter(),",
			"\t\t\t}),",
			"\t\t\tparaglideVitePlugin({",
			"\t\t\t\tproject: \"./project.inlang\",",
			"\t\t\t\toutdir: \"./src/lib/paraglide\",",
			"\t\t\t\temitTsDeclarations: true,",
			"\t\t\t}),",
			"\t\t\t$0",
			"\t\t],",
			"\t};",
			"});"
		],
		"description": [
			"[vite.config.ts] Configuración Base de Vite para SvelteKit",
			"- Tailwind v4, Paraglide (i18n), Remote Functions, Runes y Adapter Node",
			"- Guía paso a paso del proyecto: kyoz-sv-setup (en un archivo .md)"
		]
	},
	"[SvelteKit] Server Hooks": {
		"prefix": "kyoz-sv-hooks",
		"body": [
			"import type {",
			"\tHandle,",
			"\tHandleServerError,",
			"\tHandleValidationError,",
			"} from \"@sveltejs/kit\";",
			"import { sequence } from \"@sveltejs/kit/hooks\";",
			"",
			"import { getTextDirection } from \"#lib/paraglide/runtime\";",
			"import { paraglideMiddleware } from \"#lib/paraglide/server\";",
			"import { db } from \"#lib/server/db\";",
			"",
			"const handleParaglide: Handle = ({ event, resolve }) =>",
			"\tparaglideMiddleware(event.request, ({ request, locale }) => {",
			"\t\tevent.request = request;",
			"",
			"\t\treturn resolve(event, {",
			"\t\t\ttransformPageChunk: ({ html }) =>",
			"\t\t\t\thtml",
			"\t\t\t\t\t.replace(\"%paraglide.lang%\", locale)",
			"\t\t\t\t\t.replace(\"%paraglide.dir%\", getTextDirection(locale)),",
			"\t\t});",
			"\t});",
			"",
			"const handleSession: Handle = async ({ event, resolve }) => {",
			"\tconst sessionId = event.cookies.get(\"session\");",
			"",
			"\tif (!sessionId) {",
			"\t\tevent.locals.user = null;",
			"\t\tevent.locals.sessionToken = null;",
			"\t\treturn resolve(event);",
			"\t}",
			"",
			"\ttry {",
			"\t\tconst session = await db.orm.public.Session.where({ id: sessionId })",
			"\t\t\t.include(\"user\")",
			"\t\t\t.first();",
			"",
			"\t\tif (",
			"\t\t\t!session?.user ||",
			"\t\t\tnew Date() > new Date(session.expiresAt) ||",
			"\t\t\t!session.user.isActive",
			"\t\t) {",
			"\t\t\tif (session) {",
			"\t\t\t\tawait db.orm.public.Session.where({ id: sessionId })",
			"\t\t\t\t\t.delete()",
			"\t\t\t\t\t.catch(() => {});",
			"\t\t\t}",
			"\t\t\tevent.locals.user = null;",
			"\t\t\tevent.locals.sessionToken = null;",
			"\t\t\tevent.cookies.delete(\"session\", { path: \"/\" });",
			"\t\t\tevent.cookies.delete(\"session_user\", { path: \"/\" });",
			"\t\t\treturn resolve(event);",
			"\t\t}",
			"",
			"\t\tevent.locals.user = {",
			"\t\t\tid: session.user.id,",
			"\t\t\tname: session.user.name,",
			"\t\t\tusername: session.user.username,",
			"\t\t\temail: session.user.email,",
			"\t\t\trole: session.user.role,",
			"\t\t};",
			"\t\tevent.locals.sessionToken = sessionId;",
			"\t} catch (e) {",
			"\t\tconsole.error(\"[HOOKS SERVER ERROR]:\", e);",
			"\t\tevent.locals.user = null;",
			"\t\tevent.locals.sessionToken = null;",
			"\t\tevent.cookies.delete(\"session\", { path: \"/\" });",
			"\t\tevent.cookies.delete(\"session_user\", { path: \"/\" });",
			"\t}",
			"",
			"\treturn resolve(event);",
			"};",
			"",
			"export const handle: Handle = sequence(handleParaglide, handleSession);",
			"",
			"/**",
			" * Intercepta y sanitiza excepciones inesperadas ocurridas en el servidor (500).",
			" */",
			"export const handleError: HandleServerError = ({ error, event }) => {",
			"\tconst err = error as (Error & { code?: string }) | undefined;",
			"",
			"\tif (",
			"\t\terr?.code === \"ERR_INVALID_STATE\" ||",
			"\t\terr?.name === \"AbortError\" ||",
			"\t\terr?.message?.includes(\"Controller is already closed\")",
			"\t) {",
			"\t\treturn;",
			"\t}",
			"",
			"\tconsole.error(`[SERVER ERROR] en ${event.url.pathname}:`, error);",
			"",
			"\treturn {",
			"\t\tmessage: \"Ocurrió un error inesperado en el servidor.\",",
			"\t};",
			"};",
			"",
			"/**",
			" * Intercepta errores de validación de esquemas en peticiones o Remote Functions.",
			" */",
			"export const handleValidationError: HandleValidationError = () => {",
			"\treturn {",
			"\t\tmessage: \"Solicitud no válida.\",",
			"\t};",
			"};"
		],
		"description": [
			"[src/hooks.server.ts] Server Hooks para SvelteKit",
			"- Validación de sesiones en cookies, sanitización de 500 y errores de esquema"
		]
	},
	"[SvelteKit] Notifications Service": {
		"prefix": "kyoz-sv-service-notifications",
		"body": [
			"import { nanoid } from \"nanoid\";",
			"",
			"export type NotificationType = \"success\" | \"warning\" | \"error\";",
			"",
			"export type ToastPosition =",
			"\t| \"top-left\"",
			"\t| \"top-right\"",
			"\t| \"top-center\"",
			"\t| \"bottom-left\"",
			"\t| \"bottom-right\"",
			"\t| \"bottom-center\";",
			"",
			"export interface ToastState {",
			"\tid: string;",
			"\tshow: boolean;",
			"\tmessage: string;",
			"\ttype: NotificationType;",
			"\tduration: number;",
			"\tposition: ToastPosition;",
			"}",
			"",
			"interface AlertState {",
			"\tshow: boolean;",
			"\ttitle: string;",
			"\tmessage: string;",
			"\ttype: NotificationType;",
			"}",
			"",
			"class NotificationService {",
			"\ttoasts: ToastState[] = \\$state([]);",
			"",
			"\talert: AlertState = \\$state({",
			"\t\tshow: false,",
			"\t\ttitle: \"Ha ocurrido un error\",",
			"\t\tmessage:",
			"\t\t\t\"Hubo un problema al procesar la solicitud. \" +",
			"\t\t\t\"Por favor, revise los datos e intente nuevamente.\",",
			"\t\ttype: \"error\",",
			"\t});",
			"",
			"\tconfirmState = \\$state<{",
			"\t\tshow: boolean;",
			"\t\ttitle: string;",
			"\t\tmessage: string;",
			"\t\tresolve: ((value: boolean) => void) | null;",
			"\t}>({",
			"\t\tshow: false,",
			"\t\ttitle: \"\",",
			"\t\tmessage: \"\",",
			"\t\tresolve: null,",
			"\t});",
			"",
			"\t/**",
			"\t * Muestra un Toast (notificación Sonner) de forma interna",
			"\t * agregándolo a la cola.",
			"\t */",
			"\tprivate showToast(",
			"\t\ttype: NotificationType,",
			"\t\tmessage: string,",
			"\t\tduration: number = 3500,",
			"\t\tposition: ToastPosition = \"bottom-right\",",
			"\t): void {",
			"\t\tconst id = nanoid();",
			"",
			"\t\tthis.toasts.push({",
			"\t\t\tid,",
			"\t\t\tshow: true,",
			"\t\t\tmessage,",
			"\t\t\ttype,",
			"\t\t\tduration,",
			"\t\t\tposition,",
			"\t\t});",
			"",
			"\t\t// Ocultar automáticamente después del tiempo especificado",
			"\t\tsetTimeout(() => {",
			"\t\t\tthis.closeToast(id);",
			"\t\t}, duration);",
			"\t}",
			"",
			"\t/**",
			"\t * Muestra un Alert (modal central) de forma interna.",
			"\t */",
			"\tprivate showAlert(",
			"\t\ttype: NotificationType,",
			"\t\ttitle: string,",
			"\t\tmessage: string,",
			"\t): void {",
			"\t\tthis.alert.title = title;",
			"\t\tthis.alert.message = message;",
			"\t\tthis.alert.type = type;",
			"\t\tthis.alert.show = true;",
			"\t}",
			"",
			"\t/** --- API PÚBLICA --- **/",
			"",
			"\t/** Métodos de Toast (Sonner) **/",
			"\tshowToastSuccess(",
			"\t\tmessage: string,",
			"\t\tduration?: number,",
			"\t\tposition?: ToastPosition,",
			"\t): void {",
			"\t\tthis.showToast(\"success\", message, duration, position);",
			"\t}",
			"",
			"\tshowToastWarning(",
			"\t\tmessage: string,",
			"\t\tduration?: number,",
			"\t\tposition?: ToastPosition,",
			"\t): void {",
			"\t\tthis.showToast(\"warning\", message, duration, position);",
			"\t}",
			"",
			"\tshowToastError(",
			"\t\tmessage: string,",
			"\t\tduration?: number,",
			"\t\tposition?: ToastPosition,",
			"\t): void {",
			"\t\tthis.showToast(\"error\", message, duration, position);",
			"\t}",
			"",
			"\t/** Métodos de Alert (Modales) **/",
			"\tshowSuccessAlert(title: string, message: string): void {",
			"\t\tthis.showAlert(\"success\", title, message);",
			"\t}",
			"",
			"\tshowWarningAlert(title: string, message: string): void {",
			"\t\tthis.showAlert(\"warning\", title, message);",
			"\t}",
			"",
			"\tshowErrorAlert(title: string, message: string): void {",
			"\t\tthis.showAlert(\"error\", title, message);",
			"\t}",
			"",
			"\t/** Métodos de Confirmación (Modales) **/",
			"\tshowConfirmAlert(title: string, message: string): Promise<boolean> {",
			"\t\treturn new Promise<boolean>((resolve) => {",
			"\t\t\tthis.confirmState.title = title;",
			"\t\t\tthis.confirmState.message = message;",
			"\t\t\tthis.confirmState.show = true;",
			"\t\t\tthis.confirmState.resolve = resolve;",
			"\t\t});",
			"\t}",
			"",
			"\tresolveConfirm(value: boolean): void {",
			"\t\tif (this.confirmState.resolve) {",
			"\t\t\tthis.confirmState.resolve(value);",
			"\t\t}",
			"\t\tthis.confirmState.show = false;",
			"\t\tthis.confirmState.resolve = null;",
			"\t}",
			"",
			"\t/** Controles de Cierre **/",
			"\tcloseAlert(): void {",
			"\t\tthis.alert.show = false;",
			"\t}",
			"",
			"\tcloseToast(id?: string): void {",
			"\t\tif (id) {",
			"\t\t\tthis.toasts = this.toasts.filter((t) => t.id !== id);",
			"\t\t} else {",
			"\t\t\tthis.toasts = [];",
			"\t\t}",
			"\t}",
			"}",
			"",
			"export const notifications: NotificationService = new NotificationService();"
		],
		"description": [
			"[src/lib/services/notifications.svelte.ts] Servicio Reactivo de Notificaciones",
			"- Singleton con Runes ($state), soporte para toasts (éxito, aviso, error)"
		]
	}
}
