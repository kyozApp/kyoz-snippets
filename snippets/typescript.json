	"[Hono] Router Endpoint Controller": {
		"prefix": "kyoz-hono-router",
		"body": [
			"import { Hono } from \"hono\";",
			"",
			"import { describeRoute, resolver } from \"hono-openapi\";",
			"import * as v from \"valibot\";",
			"",
			"import type { AppVariables } from \"../../config/types.js\";",
			"import {",
			"\tenvelopeSchema,",
			"\tvalidator,",
			"} from \"../../middlewares/validationHelper.js\";",
			"import { ${1:Entity}Service } from \"./${2:entity}.service.js\";",
			"import {",
			"\tcreate${1:Entity}Schema,",
			"\tdelete${1:Entity}Schema,",
			"\tdetail${1:Entity}Schema,",
			"\t${2:entity}ListSchema,",
			"\ttoggle${1:Entity}StatusSchema,",
			"\tupdate${1:Entity}Schema,",
			"} from \"./${2:entity}.validation.js\";",
			"",
			"export const ${2:entity}Router = new Hono<AppVariables>();",
			"",
			"// ============================================================",
			"// QUERIES (Consultas / Lectura)",
			"// ============================================================",
			"",
			"${2:entity}Router.get(",
			"\t\"/\",",
			"\tdescribeRoute({",
			"\t\tdescription: \"Obtiene la lista completa de ${3:registros}.\",",
			"\t\ttags: [\"${4:Entidad}\"],",
			"\t\tsecurity: [{ bearerAuth: [] }],",
			"\t\tresponses: {",
			"\t\t\t200: {",
			"\t\t\t\tdescription: \"Lista obtenida exitosamente\",",
			"\t\t\t\tcontent: {",
			"\t\t\t\t\t\"application/json\": {",
			"\t\t\t\t\t\tschema: resolver(envelopeSchema(${2:entity}ListSchema.response)),",
			"\t\t\t\t\t},",
			"\t\t\t\t},",
			"\t\t\t},",
			"\t\t\t401: { description: \"No autenticado. Token no válido o expirado.\" },",
			"\t\t\t403: { description: \"Acceso denegado.\" },",
			"\t\t},",
			"\t}),",
			"\tasync (c) => {",
			"\t\tconst items = await ${1:Entity}Service.list();",
			"\t\treturn c.json(",
			"\t\t\t{",
			"\t\t\t\tsuccess: true,",
			"\t\t\t\tmessage: \"Lista de ${3:registros}\",",
			"\t\t\t\tcode: \"LIST_${1:Entity}\",",
			"\t\t\t\tstatusCode: 200,",
			"\t\t\t\tdata: items,",
			"\t\t\t\terror: null,",
			"\t\t\t},",
			"\t\t\t200,",
			"\t\t);",
			"\t},",
			");",
			"",
			"${2:entity}Router.get(",
			"\t\"/:id\",",
			"\tdescribeRoute({",
			"\t\tdescription: \"Obtiene los datos detallados de un(a) ${5:entidad} por su UUID.\",",
			"\t\ttags: [\"${4:Entidad}\"],",
			"\t\tsecurity: [{ bearerAuth: [] }],",
			"\t\tresponses: {",
			"\t\t\t200: {",
			"\t\t\t\tdescription: \"Detalles obtenidos exitosamente\",",
			"\t\t\t\tcontent: {",
			"\t\t\t\t\t\"application/json\": {",
			"\t\t\t\t\t\tschema: resolver(envelopeSchema(detail${1:Entity}Schema.response)),",
			"\t\t\t\t\t},",
			"\t\t\t\t},",
			"\t\t\t},",
			"\t\t\t400: { description: \"ID inválido.\" },",
			"\t\t\t401: { description: \"No autenticado.\" },",
			"\t\t\t403: { description: \"Acceso denegado.\" },",
			"\t\t\t404: { description: \"Registro no encontrado.\" },",
			"\t\t},",
			"\t}),",
			"\tvalidator(\"param\", detail${1:Entity}Schema.params),",
			"\tasync (c) => {",
			"\t\tconst params = c.req.valid(\"param\");",
			"\t\tconst item = await ${1:Entity}Service.findById(params);",
			"\t\treturn c.json(",
			"\t\t\t{",
			"\t\t\t\tsuccess: true,",
			"\t\t\t\tmessage: \"Detalles del registro\",",
			"\t\t\t\tcode: \"GET_${1:Entity}_DETAILS\",",
			"\t\t\t\tstatusCode: 200,",
			"\t\t\t\tdata: item,",
			"\t\t\t\terror: null,",
			"\t\t\t},",
			"\t\t\t200,",
			"\t\t);",
			"\t},",
			");",
			"",
