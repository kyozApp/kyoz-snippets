{
	"[SvelteKit] Base Layout CSS with Tailwind v4": {
		"prefix": "kyoz-sv-css",
		"body": [
			"@import \"@fontsource-variable/inter/index.css\";",
			"@import \"tailwindcss\";",
			"@plugin \"@tailwindcss/forms\";",
			"@plugin \"@tailwindcss/typography\";",
			"",
			"@theme {",
			"\t--font-sans: \"Inter Variable\", sans-serif;",
			"\t--z-base: 0;",
			"\t--z-raised: 1;",
			"\t--z-field-control: 2;",
			"\t--z-sticky: 30;",
			"\t--z-sidebar: 35;",
			"\t--z-sidebar-floating: 40;",
			"\t--z-dropdown: 1000;",
			"\t--z-fixed: 1500;",
			"\t--z-toast: 2000;",
			"\t--z-modal: 2500;",
			"\t--z-tooltip: 2800;",
			"\t--z-popover: 2900;",
			"\t--z-progress-bar: 3000;",
			"\t--z-imperative: 9999;",
			"}",
			"",
			":root {",
			"\tcolor-scheme: light;",
			"}",
			"",
			".dark {",
			"\tcolor-scheme: dark;",
			"}",
			"",
			"/* Ocultar iconos nativos de revelar/limpiar contraseñas en Edge/IE */",
			"input::-ms-reveal,",
			"input::-ms-clear {",
			"\tdisplay: none;",
			"}",
			"",
			"/* Ocultar flechas de incremento en inputs numéricos */",
			"input[type=\"number\"]::-webkit-inner-spin-button,",
			"input[type=\"number\"]::-webkit-outer-spin-button {",
			"\tmargin: 0;",
			"\t-webkit-appearance: none;",
			"}",
			"",
			"input[type=\"number\"] {",
			"\t-moz-appearance: textfield;",
			"\tappearance: textfield;",
			"}",
			"",
			"/* ============================================================",
			"   TOOLTIP UNIVERSAL EN CSS ([data-tooltip])",
			"   ============================================================ */",
			"[data-tooltip] {",
			"\tposition: relative;",
			"}",
			"",
			"[data-tooltip]::after {",
			"\tposition: absolute;",
			"\tinset-block-end: calc(100% + 7px);",
			"\tinset-inline-start: 50%;",
			"\tz-index: var(--z-tooltip, 2800);",
			"\tvisibility: hidden;",
			"\tpadding-block: 0.32rem;",
			"\tpadding-inline: 0.65rem;",
			"\tfont-size: 0.72rem;",
			"\tfont-weight: 550;",
			"\tline-height: 1;",
			"\tcolor: light-dark(oklch(20% 0.02 255), oklch(98% 0.01 255));",
			"\twhite-space: nowrap;",
			"\tpointer-events: none;",
			"\tcontent: attr(data-tooltip);",
			"\tbackground-color: light-dark(oklch(100% 0 0), oklch(18% 0.03 255));",
			"\tborder: 1px solid light-dark(oklch(85% 0.01 255), oklch(34% 0.02 255));",
			"\tborder-radius: 6px;",
			"\tbox-shadow: 0 4px 12px light-dark(oklch(0% 0 0 / 0.08), oklch(0% 0 0 / 0.3));",
			"\topacity: 0;",
			"\ttransform: translateX(-50%) translateY(4px);",
			"\ttransition:",
			"\t\topacity 0.14s ease,",
			"\t\ttransform 0.14s ease,",
			"\t\tvisibility 0.14s ease;",
			"\ttransition-delay: 0.06s;",
			"}",
			"",
			"[data-tooltip]::before {",
			"\tposition: absolute;",
			"\tinset-block-end: calc(100% + 3px);",
			"\tinset-inline-start: 50%;",
			"\tz-index: var(--z-tooltip, 2800);",
			"\tvisibility: hidden;",
			"\tpointer-events: none;",
			"\tcontent: \"\";",
			"\tborder-block-start: 4px solid light-dark(oklch(85% 0.01 255), oklch(34% 0.02 255));",
			"\tborder-inline: 4px solid transparent;",
			"\topacity: 0;",
			"\ttransform: translateX(-50%) translateY(4px);",
			"\ttransition:",
			"\t\topacity 0.14s ease,",
			"\t\ttransform 0.14s ease,",
			"\t\tvisibility 0.14s ease;",
			"\ttransition-delay: 0.06s;",
			"}",
			"",
			"[data-tooltip]:hover:not(:disabled)::after,",
			"[data-tooltip]:hover:not(:disabled)::before,",
			"[data-tooltip]:focus-visible:not(:disabled)::after,",
			"[data-tooltip]:focus-visible:not(:disabled)::before {",
			"\tvisibility: visible;",
			"\topacity: 1;",
			"\ttransform: translateX(-50%) translateY(0);",
			"}",
			"",
			"/* Variante para elementos en bordes laterales (ej. Sidebar colapsado) */",
			"[data-tooltip][data-tooltip-position=\"right\"]::after {",
			"\tinset-block-start: 50%;",
			"\tinset-block-end: auto;",
			"\tinset-inline-start: calc(100% + 9px);",
			"\ttransform: translateY(-50%) translateX(-4px);",
			"}",
			"",
			"[data-tooltip][data-tooltip-position=\"right\"]::before {",
			"\tinset-block-start: 50%;",
			"\tinset-block-end: auto;",
			"\tinset-inline-start: calc(100% + 3px);",
			"\tborder-block-start: 4px solid transparent;",
			"\tborder-block-end: 4px solid transparent;",
			"\tborder-inline-start: none;",
			"\tborder-inline-end: 4px solid",
			"\t\tlight-dark(oklch(85% 0.01 255), oklch(34% 0.02 255));",
			"\ttransform: translateY(-50%) translateX(-4px);",
			"}",
			"",
			"[data-tooltip][data-tooltip-position=\"right\"]:hover:not(:disabled)::after,",
			"[data-tooltip][data-tooltip-position=\"right\"]:hover:not(:disabled)::before,",
			"[data-tooltip][data-tooltip-position=\"right\"]:focus-visible:not(:disabled)::after,",
			"[data-tooltip][data-tooltip-position=\"right\"]:focus-visible:not(:disabled)::before {",
			"\ttransform: translateY(-50%) translateX(0);",
			"}",
			"",
			"/* ============================================================",
			"   Variante anclada a la derecha (top-end)",
			"   Ideal para botones en la última columna / celdas de acciones de tablas.",
			"   Crece hacia la izquierda y evita desbordamiento / scroll horizontal.",
			"   ============================================================ */",
			".col-actions [data-tooltip]:not([data-tooltip-position])::after,",
			".col-actions-val [data-tooltip]:not([data-tooltip-position])::after,",
			".action-cell [data-tooltip]:not([data-tooltip-position])::after,",
			"[data-tooltip][data-tooltip-position=\"top-end\"]::after {",
			"\tinset-block-end: calc(100% + 7px);",
			"\tinset-inline-start: auto;",
			"\tinset-inline-end: 0;",
			"\ttransform: translateY(4px);",
			"}",
			"",
			".col-actions [data-tooltip]:not([data-tooltip-position])::before,",
			".col-actions-val [data-tooltip]:not([data-tooltip-position])::before,",
			".action-cell [data-tooltip]:not([data-tooltip-position])::before,",
			"[data-tooltip][data-tooltip-position=\"top-end\"]::before {",
			"\tinset-block-end: calc(100% + 3px);",
			"\tinset-inline-start: auto;",
			"\tinset-inline-end: 12px;",
			"\ttransform: translateY(4px);",
			"}",
			"",
			".col-actions [data-tooltip]:not([data-tooltip-position]):hover:not(:disabled)::after,",
			".col-actions [data-tooltip]:not([data-tooltip-position]):hover:not(:disabled)::before,",
			".col-actions [data-tooltip]:not([data-tooltip-position]):focus-visible:not(:disabled)::after,",
			".col-actions [data-tooltip]:not([data-tooltip-position]):focus-visible:not(:disabled)::before,",
			".col-actions-val [data-tooltip]:not([data-tooltip-position]):hover:not(:disabled)::after,",
			".col-actions-val [data-tooltip]:not([data-tooltip-position]):hover:not(:disabled)::before,",
			".col-actions-val [data-tooltip]:not([data-tooltip-position]):focus-visible:not(:disabled)::after,",
			".col-actions-val [data-tooltip]:not([data-tooltip-position]):focus-visible:not(:disabled)::before,",
			".action-cell [data-tooltip]:not([data-tooltip-position]):hover:not(:disabled)::after,",
			".action-cell [data-tooltip]:not([data-tooltip-position]):hover:not(:disabled)::before,",
			".action-cell [data-tooltip]:not([data-tooltip-position]):focus-visible:not(:disabled)::after,",
			".action-cell [data-tooltip]:not([data-tooltip-position]):focus-visible:not(:disabled)::before,",
			"[data-tooltip][data-tooltip-position=\"top-end\"]:hover:not(:disabled)::after,",
			"[data-tooltip][data-tooltip-position=\"top-end\"]:hover:not(:disabled)::before,",
			"[data-tooltip][data-tooltip-position=\"top-end\"]:focus-visible:not(:disabled)::after,",
			"[data-tooltip][data-tooltip-position=\"top-end\"]:focus-visible:not(:disabled)::before {",
			"\tvisibility: visible;",
			"\topacity: 1;",
			"\ttransform: translateY(0);",
			"}",
			"",
			"/* ============================================================",
			"   Variante hacia la izquierda (left)",
			"   ============================================================ */",
			"[data-tooltip][data-tooltip-position=\"left\"]::after {",
			"\tinset-block-start: 50%;",
			"\tinset-block-end: auto;",
			"\tinset-inline-start: auto;",
			"\tinset-inline-end: calc(100% + 9px);",
			"\ttransform: translateY(-50%) translateX(4px);",
			"}",
			"",
			"[data-tooltip][data-tooltip-position=\"left\"]::before {",
			"\tinset-block-start: 50%;",
			"\tinset-block-end: auto;",
			"\tinset-inline-start: auto;",
			"\tinset-inline-end: calc(100% + 3px);",
			"\tborder-block-start: 4px solid transparent;",
			"\tborder-block-end: 4px solid transparent;",
			"\tborder-inline-start: 4px solid",
			"\t\tlight-dark(oklch(85% 0.01 255), oklch(34% 0.02 255));",
			"\tborder-inline-end: none;",
			"\ttransform: translateY(-50%) translateX(4px);",
			"}",
			"",
			"[data-tooltip][data-tooltip-position=\"left\"]:hover:not(:disabled)::after,",
			"[data-tooltip][data-tooltip-position=\"left\"]:hover:not(:disabled)::before,",
			"[data-tooltip][data-tooltip-position=\"left\"]:focus-visible:not(:disabled)::after,",
			"[data-tooltip][data-tooltip-position=\"left\"]:focus-visible:not(:disabled)::before {",
			"\tvisibility: visible;",
			"\topacity: 1;",
			"\ttransform: translateY(-50%) translateX(0);",
			"}"
		],
		"description": [
			"[src/routes/layout.css] Hoja de Estilos Global con Tailwind CSS v4",
			"- Tipografía Inter Variable, z-index semánticos, modo oscuro y tooltips CSS"
		]
	}
}
