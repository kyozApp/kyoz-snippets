{
	"[SvelteKit] Biome Configuration": {
		"prefix": "kyoz-sv-biome",
		"body": [
			"{",
			"\t// Esquema para autocompletado y validación de tipos en el editor",
			"\t\"\\$schema\": \"https://biomejs.dev/schemas/2.5.13/schema.json\",",
			"",
			"\t// Control de versiones: respeta automáticamente el .gitignore",
			"\t\"vcs\": {",
			"\t\t\"enabled\": true,",
			"\t\t\"clientKind\": \"git\",",
			"\t\t\"useIgnoreFile\": true",
			"\t},",
			"",
			"\t// Inclusión y exclusión de archivos:",
			"\t// - \"**\" procesa todos los archivos del proyecto.",
			"\t// - \"!!\" (doble exclamación) excluye carpetas generadas, dependencias o contratos generados.",
			"\t\"files\": {",
			"\t\t\"ignoreUnknown\": false,",
			"\t\t\"includes\": [",
			"\t\t\t\"**\",",
			"\t\t\t\"!!**/.svelte-kit\",",
			"\t\t\t\"!!**/build\",",
			"\t\t\t\"!!**/.pnpm-store\",",
			"\t\t\t\"!!**/pnpm-lock.yaml\",",
			"\t\t\t\"!!**/scripts/*.json\",",
			"\t\t\t\"!!**/migrations\",",
			"\t\t\t\"!!**/src/prisma/contract.d.ts\",",
			"\t\t\t\"!!**/src/prisma/contract.json\"",
			"\t\t]",
			"\t},",
			"",
			"\t// Soporte y parseo de directivas Tailwind CSS v4 (@theme, @utility, etc.)",
			"\t\"css\": {",
			"\t\t\"parser\": {",
			"\t\t\t\"tailwindDirectives\": true",
			"\t\t}",
			"\t},",
			"",
			"\t// Reglas de formateo global con tabs duros (hard tabs)",
			"\t\"formatter\": {",
			"\t\t\"enabled\": true,",
			"\t\t\"indentStyle\": \"tab\",",
			"\t\t\"indentWidth\": 2",
			"\t},",
			"",
			"\t// Reglas del linter recomendadas para Svelte y Tailwind",
			"\t\"linter\": {",
			"\t\t\"enabled\": true,",
			"\t\t\"domains\": {",
			"\t\t\t\"svelte\": \"recommended\",",
			"\t\t\t\"tailwind\": \"recommended\"",
			"\t\t},",
			"\t\t\"rules\": {",
			"\t\t\t\"preset\": \"recommended\",",
			"\t\t\t\"style\": {",
			"\t\t\t\t\"noNonNullAssertion\": \"off\",",
			"\t\t\t\t\"noDescendingSpecificity\": \"off\",",
			"\t\t\t\t// Prohíbe colores hex directos (obliga a usar variables de diseño o Tailwind)",
			"\t\t\t\t\"noHexColors\": \"error\",",
			"\t\t\t\t// Advierte si un archivo supera las 1500 líneas (excluyendo líneas en blanco)",
			"\t\t\t\t\"noExcessiveLinesPerFile\": {",
			"\t\t\t\t\t\"level\": \"warn\",",
			"\t\t\t\t\t\"options\": {",
			"\t\t\t\t\t\t\"maxLines\": 1500,",
			"\t\t\t\t\t\t\"skipBlankLines\": true",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t},",
			"\t\t\t\"complexity\": {",
			"\t\t\t\t// Evita el uso de !important en estilos CSS",
			"\t\t\t\t\"noImportantStyles\": \"error\"",
			"\t\t\t},",
			"\t\t\t\"correctness\": {",
			"\t\t\t\t\"noMissingVarFunction\": \"error\",",
			"\t\t\t\t\"noInvalidPositionAtImportRule\": \"error\",",
			"\t\t\t\t\"noUnknownProperty\": \"error\",",
			"\t\t\t\t\"noUnknownUnit\": \"error\",",
			"\t\t\t\t\"noUnknownFunction\": \"error\"",
			"\t\t\t},",
			"\t\t\t\"suspicious\": {",
			"\t\t\t\t\"noDuplicateProperties\": \"error\",",
			"\t\t\t\t\"noEmptyBlock\": \"error\",",
			"\t\t\t\t\"noDuplicateAtImportRules\": \"error\",",
			"\t\t\t\t\"noDuplicateSelectorsKeyframeBlock\": \"error\",",
			"\t\t\t\t// Directivas y at-rules de Tailwind v4 ignoradas para evitar falsos errores",
			"\t\t\t\t\"noUnknownAtRules\": {",
			"\t\t\t\t\t\"level\": \"error\",",
			"\t\t\t\t\t\"options\": {",
			"\t\t\t\t\t\t\"ignore\": [",
			"\t\t\t\t\t\t\t\"theme\",",
			"\t\t\t\t\t\t\t\"plugin\",",
			"\t\t\t\t\t\t\t\"utility\",",
			"\t\t\t\t\t\t\t\"variant\",",
			"\t\t\t\t\t\t\t\"custom-variant\",",
			"\t\t\t\t\t\t\t\"source\"",
			"\t\t\t\t\t\t]",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t},",
			"\t\t\t\"nursery\": {",
			"\t\t\t\t// Ordenamiento automático de clases Tailwind en atributos y funciones",
			"\t\t\t\t\"useSortedClasses\": {",
			"\t\t\t\t\t\"level\": \"warn\",",
			"\t\t\t\t\t\"fix\": \"safe\",",
			"\t\t\t\t\t\"options\": {",
			"\t\t\t\t\t\t\"attributes\": [\"class\", \"className\", \"classList\"],",
			"\t\t\t\t\t\t\"functions\": [\"clsx\", \"cva\", \"tw\", \"tv\"]",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t},",
			"",
			"\t// Formateador experimental para plantillas HTML",
			"\t\"html\": {",
			"\t\t\"formatter\": {",
			"\t\t\t\"enabled\": true",
			"\t\t},",
			"\t\t\"experimentalFullSupportEnabled\": true",
			"\t},",
			"",
			"\t// Comillas dobles consistentes en JavaScript y TypeScript",
			"\t\"javascript\": {",
			"\t\t\"formatter\": {",
			"\t\t\t\"quoteStyle\": \"double\"",
			"\t\t}",
			"\t},",
			"",
			"\t// Asistencia para ordenar y agrupar automáticamente los imports al guardar",
			"\t\"assist\": {",
			"\t\t\"enabled\": true,",
			"\t\t\"actions\": {",
			"\t\t\t\"source\": {",
			"\t\t\t\t\"organizeImports\": {",
			"\t\t\t\t\t\"level\": \"on\",",
			"\t\t\t\t\t\"options\": {",
			"\t\t\t\t\t\t\"groups\": [",
			"\t\t\t\t\t\t\t\":NODE:\",",
			"\t\t\t\t\t\t\t\":BLANK_LINE:\",",
			"\t\t\t\t\t\t\t[\"svelte\", \"svelte/**\", \"@sveltejs/**\", \"\\$app/**\", \"\\$env/**\"],",
			"\t\t\t\t\t\t\t\":BLANK_LINE:\",",
			"\t\t\t\t\t\t\t\":PACKAGE:\",",
			"\t\t\t\t\t\t\t\":BLANK_LINE:\",",
			"\t\t\t\t\t\t\t[\"#lib/**\", \"@/**\"],",
			"\t\t\t\t\t\t\t\":BLANK_LINE:\",",
			"\t\t\t\t\t\t\t\":PATH:\",",
			"\t\t\t\t\t\t\t\":BLANK_LINE:\",",
			"\t\t\t\t\t\t\t\":STYLE:\"",
			"\t\t\t\t\t\t]",
			"\t\t\t\t\t}",
			"\t\t\t\t},",
			"\t\t\t\t\"useSortedProperties\": \"on\",",
			"\t\t\t\t\"useSortedPackageJson\": \"on\"",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"}"
		],
		"description": [
			"[biome.json] Configuración de Biome",
			"- Hard tabs (ancho 2), linter para Svelte y Tailwind v4, y orden de imports"
		]
	},
	"[SvelteKit] Zed Settings Configuration": {
		"prefix": "kyoz-sv-zed",
		"body": [
			"{",
			"\t// Configuración de lenguajes y formateador Biome en Zed",
			"\t\"languages\": {",
			"\t\t\"JSON\": {",
			"\t\t\t\"tab_size\": 2,",
			"\t\t\t\"hard_tabs\": true,",
			"\t\t\t\"prettier\": { \"allowed\": false },",
			"\t\t\t\"formatter\": { \"language_server\": { \"name\": \"biome\" } }",
			"\t\t},",
			"\t\t\"JSONC\": {",
			"\t\t\t\"tab_size\": 2,",
			"\t\t\t\"hard_tabs\": true,",
			"\t\t\t\"prettier\": { \"allowed\": false },",
			"\t\t\t\"formatter\": { \"language_server\": { \"name\": \"biome\" } }",
			"\t\t},",
			"\t\t\"HTML\": {",
			"\t\t\t\"tab_size\": 2,",
			"\t\t\t\"hard_tabs\": true,",
			"\t\t\t\"prettier\": { \"allowed\": false },",
			"\t\t\t\"formatter\": { \"language_server\": { \"name\": \"biome\" } }",
			"\t\t},",
			"\t\t\"CSS\": {",
			"\t\t\t\"tab_size\": 2,",
			"\t\t\t\"hard_tabs\": true,",
			"\t\t\t\"prettier\": { \"allowed\": false },",
			"\t\t\t\"language_servers\": [",
			"\t\t\t\t\"tailwindcss-intellisense-css\",",
			"\t\t\t\t\"!vscode-css-language-server\",",
			"\t\t\t\t\"...\"",
			"\t\t\t],",
			"\t\t\t\"formatter\": { \"language_server\": { \"name\": \"biome\" } }",
			"\t\t},",
			"\t\t\"JavaScript\": {",
			"\t\t\t\"tab_size\": 2,",
			"\t\t\t\"hard_tabs\": true,",
			"\t\t\t\"prettier\": { \"allowed\": false },",
			"\t\t\t\"formatter\": { \"language_server\": { \"name\": \"biome\" } }",
			"\t\t},",
			"\t\t\"TypeScript\": {",
			"\t\t\t\"tab_size\": 2,",
			"\t\t\t\"hard_tabs\": true,",
			"\t\t\t\"prettier\": { \"allowed\": false },",
			"\t\t\t\"formatter\": { \"language_server\": { \"name\": \"biome\" } }",
			"\t\t},",
			"\t\t\"Svelte\": {",
			"\t\t\t\"tab_size\": 2,",
			"\t\t\t\"hard_tabs\": true,",
			"\t\t\t\"formatter\": { \"language_server\": { \"name\": \"biome\" } }",
			"\t\t}",
			"\t},",
			"",
			"\t// Configuración del Language Server de Tailwind CSS para Svelte",
			"\t\"lsp\": {",
			"\t\t\"tailwindcss-language-server\": {",
			"\t\t\t\"settings\": {",
			"\t\t\t\t\"includeLanguages\": { \"svelte\": \"html\" },",
			"\t\t\t\t\"experimental\": {",
			"\t\t\t\t\t\"classRegex\": [",
			"\t\t\t\t\t\t\"class=\\\"([^\\\"]*)\\\"\",",
			"\t\t\t\t\t\t\"class='([^']*)'\",",
			"\t\t\t\t\t\t\"class:\\\\s*([^\\\\s{]+)\",",
			"\t\t\t\t\t\t\"\\\\{\\\\s*class:\\\\s*\\\"([^\\\"]*)\\\"\",",
			"\t\t\t\t\t\t\"\\\\{\\\\s*class:\\\\s*'([^']*)'\"",
			"\t\t\t\t\t]",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"}"
		],
		"description": [
			"[.zed/settings.json] Configuración de Workspace para Zed",
			"- Hard tabs (ancho 2), Biome como formateador y Tailwind LSP para Svelte"
		]
	},
	"[SvelteKit] TypeScript Configuration": {
		"prefix": "kyoz-sv-tsconfig",
		"body": [
			"{",
			"\t\"extends\": \"./.svelte-kit/tsconfig.json\",",
			"\t\"compilerOptions\": {",
			"\t\t\"rewriteRelativeImportExtensions\": true,",
			"\t\t\"allowJs\": true,",
			"\t\t\"checkJs\": true,",
			"\t\t\"esModuleInterop\": true,",
			"\t\t\"forceConsistentCasingInFileNames\": true,",
			"\t\t\"resolveJsonModule\": true,",
			"\t\t\"skipLibCheck\": true,",
			"\t\t\"sourceMap\": true,",
			"\t\t\"strict\": true,",
			"\t\t\"moduleResolution\": \"bundler\",",
			"\t\t\"module\": \"preserve\",",
			"\t\t\"types\": [\"node\"]",
			"\t},",
			"\t\"exclude\": [\"node_modules\", \"prisma.config.ts\"]",
			"}"
		],
		"description": [
			"[tsconfig.json] Configuración TypeScript estricta para SvelteKit",
			"- Modos estrictos, module preserve y resolución bundler para Svelte 5"
		]
	}
}
