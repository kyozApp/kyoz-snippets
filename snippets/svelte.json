	"[SvelteKit] Notifications Container Component": {
		"prefix": "kyoz-sv-comp-notifications",
		"body": [
			"<script lang=\"ts\">",
			"import { fade, fly, scale } from \"svelte/transition\";",
			"",
			"import { CircleCheck, CircleX, TriangleAlert, X } from \"@lucide/svelte\";",
			"",
			"import type { ToastPosition } from \"#lib/services/notifications.svelte\";",
			"import { notifications } from \"#lib/services/notifications.svelte\";",
			"",
			"const positions: ToastPosition[] = [",
			"\t\"top-left\",",
			"\t\"top-right\",",
			"\t\"top-center\",",
			"\t\"bottom-left\",",
			"\t\"bottom-right\",",
			"\t\"bottom-center\",",
			"];",
			"",
			"// Referencias de elementos DOM para promoverlos a la Top Layer (Popover API)",
			"let toastPopoverEls = \\$state<Record<string, HTMLElement>>({});",
			"let alertPopoverEl = \\$state<HTMLElement>();",
			"let confirmPopoverEl = \\$state<HTMLElement>();",
			"",
			"// Sincroniza los contenedores de toasts con la Popover API de forma reactiva",
			"\\$effect(() => {",
			"\tfor (const pos of positions) {",
			"\t\tconst el = toastPopoverEls[pos];",
			"\t\tif (el) {",
			"\t\t\tconst hasToasts = notifications.toasts.some((t) => t.position === pos);",
			"\t\t\tif (hasToasts) {",
			"\t\t\t\ttry {",
			"\t\t\t\t\t// Si ya está abierto, hide y show lo fuerza a reposicionarse al",
			"\t\t\t\t\t// frente de la Top Layer",
			"\t\t\t\t\tif (el.matches(\":popover-open\")) {",
			"\t\t\t\t\t\tel.hidePopover();",
			"\t\t\t\t\t}",
			"\t\t\t\t\tel.showPopover();",
			"\t\t\t\t} catch {",
			"\t\t\t\t\t// Ignora excepciones si el navegador ya maneja el estado del",
			"\t\t\t\t\t// popover o si se está desmontando",
			"\t\t\t\t}",
			"\t\t\t} else {",
			"\t\t\t\ttry {",
			"\t\t\t\t\tif (el.matches(\":popover-open\")) {",
			"\t\t\t\t\t\tel.hidePopover();",
			"\t\t\t\t\t}",
			"\t\t\t\t} catch {",
			"\t\t\t\t\t// Ignora excepciones al intentar cerrar el popover si el",
			"\t\t\t\t\t// navegador ya lo hizo automáticamente",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"});",
			"",
			"// Sincroniza el modal de Alerta con la Popover API de forma reactiva",
			"\\$effect(() => {",
			"\tif (notifications.alert.show) {",
			"\t\ttry {",
			"\t\t\tif (alertPopoverEl?.matches(\":popover-open\")) {",
			"\t\t\t\talertPopoverEl.hidePopover();",
			"\t\t\t}",
			"\t\t\talertPopoverEl?.showPopover();",
			"\t\t} catch {",
			"\t\t\ttry {",
			"\t\t\t\talertPopoverEl?.showPopover();",
			"\t\t\t} catch {",
			"\t\t\t\t// Ignora excepciones de estado del popover de alerta al forzar",
			"\t\t\t\t// su apertura",
			"\t\t\t}",
			"\t\t}",
			"\t} else {",
			"\t\ttry {",
			"\t\t\tif (alertPopoverEl?.matches(\":popover-open\")) {",
			"\t\t\t\talertPopoverEl.hidePopover();",
			"\t\t\t}",
			"\t\t} catch {",
			"\t\t\t// Ignora excepciones del navegador al cerrar la alerta",
			"\t\t}",
			"\t}",
			"});",
			"",
			"// Sincroniza el modal de Confirmación con la Popover API de forma reactiva",
			"\\$effect(() => {",
			"\tif (notifications.confirmState.show) {",
			"\t\ttry {",
			"\t\t\tif (confirmPopoverEl?.matches(\":popover-open\")) {",
			"\t\t\t\tconfirmPopoverEl.hidePopover();",
			"\t\t\t}",
			"\t\t\tconfirmPopoverEl?.showPopover();",
			"\t\t} catch {",
			"\t\t\ttry {",
			"\t\t\t\tconfirmPopoverEl?.showPopover();",
			"\t\t\t} catch {",
			"\t\t\t\t// Ignora excepciones de estado del popover de confirmación al",
			"\t\t\t\t// forzar su apertura",
			"\t\t\t}",
			"\t\t}",
			"\t} else {",
			"\t\ttry {",
			"\t\t\tif (confirmPopoverEl?.matches(\":popover-open\")) {",
			"\t\t\t\tconfirmPopoverEl.hidePopover();",
			"\t\t\t}",
			"\t\t} catch {",
			"\t\t\t// Ignora excepciones del navegador al cerrar la confirmación",
			"\t\t}",
			"\t}",
			"});",
			"",
			"// Re-promueve todas las notificaciones activas al frente de la Top Layer",
			"const repromoteActivePopovers = () => {",
			"\t// Pequeño retardo de 10ms para permitir que el diálogo modal termine de",
			"\t// registrarse en la Top Layer",
			"\tsetTimeout(() => {",
			"\t\tfor (const pos of positions) {",
			"\t\t\tconst el = toastPopoverEls[pos];",
			"\t\t\tif (el) {",
			"\t\t\t\tconst hasToasts = notifications.toasts.some((t) => t.position === pos);",
			"\t\t\t\tif (hasToasts && el.matches(\":popover-open\")) {",
			"\t\t\t\t\ttry {",
			"\t\t\t\t\t\tel.hidePopover();",
			"\t\t\t\t\t\tel.showPopover();",
			"\t\t\t\t\t} catch {",
			"\t\t\t\t\t\t// Ignorar excepciones al re-promover el popover de toasts",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"",
			"\t\t// También re-promover el modal de alerta si está activo",
			"\t\tif (notifications.alert.show && alertPopoverEl?.matches(\":popover-open\")) {",
			"\t\t\ttry {",
			"\t\t\t\talertPopoverEl.hidePopover();",
			"\t\t\t\talertPopoverEl.showPopover();",
			"\t\t\t} catch {",
			"\t\t\t\t// Ignorar excepciones al re-promover el popover de alerta",
			"\t\t\t}",
			"\t\t}",
			"",
			"\t\t// También re-promover el modal de confirmación si está activo",
			"\t\tif (",
			"\t\t\tnotifications.confirmState.show &&",
			"\t\t\tconfirmPopoverEl?.matches(\":popover-open\")",
			"\t\t) {",
			"\t\t\ttry {",
			"\t\t\t\tconfirmPopoverEl.hidePopover();",
			"\t\t\t\tconfirmPopoverEl.showPopover();",
			"\t\t\t} catch {",
			"\t\t\t\t// Ignorar excepciones al re-promover el popover de confirmación",
			"\t\t\t}",
			"\t\t}",
			"\t}, 10);",
			"};",
			"",
			"// Observador global para reposicionar las notificaciones al frente cuando",
			"// se abre o cierra cualquier <dialog> (modal)",
			"\\$effect(() => {",
			"\tif (typeof document === \"undefined\") return;",
			"",
			"\tconst observer = new MutationObserver((mutations) => {",
			"\t\tfor (const mutation of mutations) {",
			"\t\t\tif (mutation.type === \"attributes\" && mutation.attributeName === \"open\") {",
			"\t\t\t\tconst target = mutation.target as HTMLElement;",
			"\t\t\t\tif (target.tagName === \"DIALOG\") {",
			"\t\t\t\t\trepromoteActivePopovers();",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t});",
			"",
			"\tobserver.observe(document.body, {",
			"\t\tattributes: true,",
			"\t\tsubtree: true,",
			"\t\tattributeFilter: [\"open\"],",
			"\t});",
			"",
			"\treturn () => {",
			"\t\tobserver.disconnect();",
			"\t};",
			"});",
			"</script>",
			"",
			"<!-- Contenedores de Sonner (Toasts agrupados por posición en pantalla) -->",
			"{#each positions as pos (pos)}",
			"\t{@const posToasts = notifications.toasts.filter((t) => t.position === pos)}",
			"\t<div",
			"\t\tbind:this={toastPopoverEls[pos]}",
			"\t\tpopover=\"manual\"",
			"\t\tclass=\"sonner-container pos-{pos}\"",
			"\t>",
			"\t\t{#each posToasts as toast (toast.id)}",
			"\t\t\t<div",
			"\t\t\t\tclass=\"sonner-toast sonner-{toast.type}\"",
			"\t\t\t\ttransition:fly={{ y: pos.startsWith(\"top\") ? -50 : 50, duration: 350 }}",
			"\t\t\t\trole=\"status\"",
			"\t\t\t\taria-live=\"polite\"",
			"\t\t\t>",
			"\t\t\t\t<div class=\"sonner-glow\"></div>",
			"\t\t\t\t<div class=\"sonner-content\">",
			"\t\t\t\t\t<div class=\"icon-wrapper\">",
			"\t\t\t\t\t\t{#if toast.type === \"success\"}",
			"\t\t\t\t\t\t\t<CircleCheck size=\"20\" />",
			"\t\t\t\t\t\t{:else if toast.type === \"warning\"}",
			"\t\t\t\t\t\t\t<TriangleAlert size=\"20\" />",
			"\t\t\t\t\t\t{:else}",
			"\t\t\t\t\t\t\t<CircleX size=\"20\" />",
			"\t\t\t\t\t\t{/if}",
			"\t\t\t\t\t</div>",
			"\t\t\t\t\t<div class=\"sonner-body\">",
			"\t\t\t\t\t\t<p class=\"sonner-title\">",
			"\t\t\t\t\t\t\t{#if toast.type === \"success\"}",
			"\t\t\t\t\t\t\t\t¡Éxito!",
			"\t\t\t\t\t\t\t{:else if toast.type === \"warning\"}",
			"\t\t\t\t\t\t\t\t¡Advertencia!",
			"\t\t\t\t\t\t\t{:else}",
			"\t\t\t\t\t\t\t\t¡Error!",
			"\t\t\t\t\t\t\t{/if}",
			"\t\t\t\t\t\t</p>",
			"\t\t\t\t\t\t<p class=\"sonner-message\">{toast.message}</p>",
			"\t\t\t\t\t</div>",
			"\t\t\t\t\t<button",
			"\t\t\t\t\t\ttype=\"button\"",
			"\t\t\t\t\t\tclass=\"sonner-close-btn\"",
			"\t\t\t\t\t\tonclick={() => notifications.closeToast(toast.id)}",
			"\t\t\t\t\t\taria-label=\"Cerrar notificación\"",
			"\t\t\t\t\t>",
			"\t\t\t\t\t\t<X size=\"16\" />",
			"\t\t\t\t\t</button>",
			"\t\t\t\t</div>",
			"\t\t\t\t<div",
			"\t\t\t\t\tclass=\"sonner-progress\"",
			"\t\t\t\t\tstyle=\"animation-duration: {toast.duration}ms;\"",
			"\t\t\t\t></div>",
			"\t\t\t</div>",
			"\t\t{/each}",
			"\t</div>",
			"{/each}",
			"",
			"<!-- Contenedor del Alert (Modal central, no se oculta hasta dar clic) -->",
			"<div bind:this={alertPopoverEl} popover=\"manual\" class=\"alert-popover\">",
			"\t{#if notifications.alert.show}",
			"\t\t<div",
			"\t\t\tclass=\"alert-backdrop\"",
			"\t\t\ttransition:fade={{ duration: 250 }}",
			"\t\t\trole=\"presentation\"",
			"\t\t>",
			"\t\t\t<div",
