	"[SvelteKit] Native Dialog Modal": {
		"prefix": "kyoz-sv-comp-modal",
		"body": [
			"<script lang=\"ts\">",
			"import type { Snippet } from \"svelte\";",
			"",
			"interface Props {",
			"\tisOpen: boolean;",
			"\tonRequestClose?: () => void;",
			"\twidth?: \"small\" | \"medium\" | \"large\" | string;",
			"\tchildren: Snippet;",
			"}",
			"",
			"let { isOpen, onRequestClose, width = \"medium\", children }: Props = \\$props();",
			"",
			"let dialogEl = \\$state<HTMLDialogElement | null>(null);",
			"",
			"const resolvedMaxInlineSize = \\$derived(",
			"\twidth === \"small\"",
			"\t\t? \"550px\"",
			"\t\t: width === \"medium\"",
			"\t\t\t? \"650px\"",
			"\t\t\t: width === \"large\"",
			"\t\t\t\t? \"1500px\"",
			"\t\t\t\t: width,",
			");",
			"",
			"\\$effect(() => {",
			"\tif (!dialogEl) return;",
			"",
			"\tif (isOpen && !dialogEl.open) {",
			"\t\tdialogEl.showModal();",
			"\t} else if (!isOpen && dialogEl.open) {",
			"\t\tdialogEl.close();",
			"\t}",
			"});",
			"</script>",
			"",
			"<dialog",
			"\tbind:this={dialogEl}",
			"\toncancel={(e) => {",
			"\t\te.preventDefault();",
			"\t\tonRequestClose?.();",
			"\t}}",
			"\taria-modal=\"true\"",
			"\tclass=\"modal-dialog\"",
			"\tstyle:--modal-max-inline-size={resolvedMaxInlineSize}",
			">",
			"\t{@render children()}",
			"</dialog>",
			"",
			"<style>",
			".modal-dialog {",
			"\tinline-size: min(90vi, var(--modal-max-inline-size));",
			"\tmax-inline-size: 100%;",
			"\tmax-block-size: 90dvh;",
			"\tpadding: 0;",
			"\tmargin: auto;",
			"\toverflow: hidden;",
			"\toverscroll-behavior: contain;",
			"",
			"\tbackground-color: light-dark(oklch(100% 0 0), oklch(25% 0.03 255));",
			"\tborder: 1px solid light-dark(oklch(90% 0.02 255), oklch(35% 0.03 255));",
			"\tborder-radius: 12px;",
			"\tbox-shadow: 0 25px 50px -12px oklch(0% 0 0 / 0.25);",
			"",
			"\ttransition: inline-size 0.3s cubic-bezier(0.4, 0, 0.2, 1);",
			"",
			"\t&::backdrop {",
			"\t\tbackground-color: light-dark(oklch(0% 0 0 / 0.4), oklch(0% 0 0 / 0.6));",
			"\t\tbackdrop-filter: blur(4px);",
			"",
			"\t\ttransition: backdrop-filter 0.3s ease;",
			"\t}",
			"",
			"\t&[open] {",
			"\t\tdisplay: flex;",
			"\t\tflex-direction: column;",
			"\t}",
			"}",
			"</style>"
		],
		"description": [
			"[src/lib/components/ui/modals/Modal.svelte] Modal Declarativo con <dialog>",
			"- Diálogo nativo accesible, efecto reactivo showModal/close y backdrop blur"
		]
	},
