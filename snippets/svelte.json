{
	"[SvelteKit] Remote Form Component": {
		"prefix": "kyoz-sv-comp-form",
		"body": [
			"<script lang=\"ts\">",
			"import { isHttpError } from \"@sveltejs/kit\";",
			"import { LoaderCircle } from \"@lucide/svelte\";",
			"",
			"import { update${1:Entity} } from \"#lib/remote/${2:entity}/${2:entity}.form.remote\";",
			"import { get${1:Entity}Details } from \"#lib/remote/${2:entity}/${2:entity}.query.remote\";",
			"import { notifications } from \"#lib/services/notifications.svelte\";",
			"import { ${2:entity}UpdateSchema } from \"#lib/validations/${2:entity}/${2:entity}.form.validation\";",
			"",
			"interface Props {",
			"\t${2:entity}Id: string;",
			"}",
			"",
			"let { ${2:entity}Id }: Props = \\$props();",
			"",
			"// svelte-ignore state_referenced_locally",
			"const updateForm = update${1:Entity}.for(${2:entity}Id);",
			"",
			"const {",
			"\tid: fieldId,",
			"\t${3:name}: field${4:Name},",
			"} = updateForm.fields;",
			"",
			"const submitting = \\$derived(updateForm.pending > 0);",
			"</script>",
			"",
			"<svelte:boundary>",
			"\t{@const details = await get${1:Entity}Details({ id: ${2:entity}Id })}",
			"",
			"\t<form",
			"\t\t{...updateForm.preflight(${2:entity}UpdateSchema.body)}",
			"\t\t{...updateForm.enhance(async (f) => {",
			"\t\t\ttry {",
			"\t\t\t\tconst ok = await f.submit();",
			"",
			"\t\t\t\tif (ok) {",
			"\t\t\t\t\tconst res = f.result;",
			"\t\t\t\t\tif (res && !res.success) {",
			"\t\t\t\t\t\tnotifications.showToastError(res.error);",
			"\t\t\t\t\t\treturn;",
			"\t\t\t\t\t}",
			"",
			"\t\t\t\t\tnotifications.showToastSuccess(\"¡${1:Registro} actualizado correctamente!\");",
			"\t\t\t\t\treturn;",
			"\t\t\t\t}",
			"",
			"\t\t\t\tnotifications.showToastError(",
			"\t\t\t\t\t\"Ocurrió un problema inesperado al actualizar el registro.\",",
			"\t\t\t\t);",
			"\t\t\t} catch (e) {",
			"\t\t\t\tif (isHttpError(e)) {",
			"\t\t\t\t\tnotifications.showToastError(",
			"\t\t\t\t\t\te.body?.message || \"No pudimos actualizar el registro en este momento.\",",
			"\t\t\t\t\t);",
			"\t\t\t\t} else {",
			"\t\t\t\t\tnotifications.showToastError(",
			"\t\t\t\t\t\t\"No se pudo establecer comunicación con el servidor.\",",
			"\t\t\t\t\t);",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t})}",
			"\t\toninput={() => updateForm.validate()}",
			"\t\tnovalidate",
			"\t>",
			"\t\t<input {...fieldId.as(\"hidden\", details.id)} />",
			"",
			"\t\t<div>",
			"\t\t\t<label for=\"${2:entity}-${3:name}\">${4:Nombre}</label>",
			"\t\t\t<input",
			"\t\t\t\t{...field${4:Name}.as(\"text\", details.${3:name})}",
			"\t\t\t\tid=\"${2:entity}-${3:name}\"",
			"\t\t\t\tdisabled={submitting}",
			"\t\t\t/>",
			"\t\t\t{#if field${4:Name}.issues()?.length}",
			"\t\t\t\t<span>{field${4:Name}.issues()?.[0]?.message}</span>",
			"\t\t\t{/if}",
			"\t\t</div>",
			"\t\t$0",
			"",
			"\t\t<div>",
			"\t\t\t<button type=\"submit\" disabled={submitting}>",
			"\t\t\t\t{#if submitting}",
			"\t\t\t\t\t<LoaderCircle size={16} class=\"spinner\" />",
			"\t\t\t\t\t<span>Guardando...</span>",
			"\t\t\t\t{:else}",
			"\t\t\t\t\t<span>Guardar Cambios</span>",
			"\t\t\t\t{/if}",
			"\t\t\t</button>",
			"\t\t</div>",
			"\t</form>",
			"",
			"\t{#snippet pending()}",
			"\t\t<div>",
			"\t\t\t<LoaderCircle size={20} class=\"spinner\" />",
			"\t\t\t<span>Cargando datos...</span>",
			"\t\t</div>",
			"\t{/snippet}",
			"",
			"\t{#snippet failed()}",
			"\t\t<div>",
			"\t\t\t<span>Error al cargar los datos. Por favor, recarga la página.</span>",
			"\t\t</div>",
			"\t{/snippet}",
			"</svelte:boundary>"
		],
		"description": [
			"[src/lib/components/.../*Form.svelte] Formulario Reactivo con Remote Form",
			"- Boundary con estados pending/failed, validación preflight y feedback toast",
			"- Se conecta con: *.form.remote.ts, *.query.remote.ts y *.form.validation.ts"
		]
	},
	"[SvelteKit] Remote Table Component": {
		"prefix": "kyoz-sv-comp-table",
		"body": [
			"<script lang=\"ts\">",
			"import { LoaderCircle, Search, X } from \"@lucide/svelte\";",
			"",
			"import { get${1:Entity}List } from \"#lib/remote/${2:entity}/${2:entity}.query.remote\";",
			"import type { ${1:Entity}ListItemResponse } from \"#lib/validations/${2:entity}/${2:entity}.query.validation\";",
			"",
			"let searchQuery = \\$state(\"\");",
			"",
			"const filterItems = (list: ${1:Entity}ListItemResponse[], search: string) => {",
			"\tif (!search.trim()) return list;",
			"\tconst q = search.toLowerCase().trim();",
			"\treturn list.filter((item) => item.${3:name}.toLowerCase().includes(q));",
			"};",
			"</script>",
			"",
			"<div>",
			"\t<div>",
			"\t\t<input",
			"\t\t\ttype=\"text\"",
			"\t\t\tbind:value={searchQuery}",
			"\t\t\tplaceholder=\"Buscar ${2:entity}...\"",
			"\t\t/>",
			"\t\t{#if searchQuery}",
			"\t\t\t<button type=\"button\" onclick={() => (searchQuery = \"\")}>",
			"\t\t\t\t<X size={14} />",
			"\t\t\t</button>",
			"\t\t{/if}",
			"\t</div>",
			"",
			"\t<table>",
			"\t\t<thead>",
			"\t\t\t<tr>",
			"\t\t\t\t<th>Item</th>",
			"\t\t\t\t<th>${4:Nombre}</th>",
			"\t\t\t\t<th>Acciones</th>",
			"\t\t\t</tr>",
			"\t\t</thead>",
			"\t\t<tbody>",
			"\t\t\t<svelte:boundary>",
			"\t\t\t\t{@const list = await get${1:Entity}List()}",
			"\t\t\t\t{@const filtered = filterItems(list, searchQuery)}",
			"",
			"\t\t\t\t{#if filtered.length === 0}",
			"\t\t\t\t\t<tr>",
			"\t\t\t\t\t\t<td colspan=\"3\">No se encontraron registros.</td>",
			"\t\t\t\t\t</tr>",
			"\t\t\t\t{/if}",
			"",
			"\t\t\t\t{#each filtered as item, index (item.id)}",
			"\t\t\t\t\t<tr>",
			"\t\t\t\t\t\t<td>{index + 1}</td>",
			"\t\t\t\t\t\t<td>{item.${3:name}}</td>",
			"\t\t\t\t\t\t<td>",
			"\t\t\t\t\t\t\t$0",
			"\t\t\t\t\t\t</td>",
			"\t\t\t\t\t</tr>",
			"\t\t\t\t{/each}",
			"",
			"\t\t\t\t{#snippet pending()}",
			"\t\t\t\t\t<tr>",
			"\t\t\t\t\t\t<td colspan=\"3\">",
			"\t\t\t\t\t\t\t<LoaderCircle size={20} class=\"spinner\" />",
			"\t\t\t\t\t\t\t<span>Cargando ${2:registros}...</span>",
			"\t\t\t\t\t\t</td>",
			"\t\t\t\t\t</tr>",
			"\t\t\t\t{/snippet}",
			"",
			"\t\t\t\t{#snippet failed()}",
			"\t\t\t\t\t<tr>",
			"\t\t\t\t\t\t<td colspan=\"3\">",
			"\t\t\t\t\t\t\t<span>Error al cargar los ${2:registros}. Por favor, recarga la página.</span>",
			"\t\t\t\t\t\t</td>",
			"\t\t\t\t\t</tr>",
			"\t\t\t\t{/snippet}",
			"",
			"\t\t\t</svelte:boundary>",
			"\t\t</tbody>",
			"\t</table>",
			"</div>"
		],
		"description": [
			"[src/lib/components/.../*Table.svelte] Tabla Reactiva con Remote Query",
			"- Boundary asíncrono con buscador reactivo, loading state y renderizado tipado",
			"- Se conecta con: *.query.remote.ts"
		]
	},
	"[SvelteKit] Remote Command Button": {
		"prefix": "kyoz-sv-comp-button",
		"body": [
			"<script lang=\"ts\">",
			"import { isHttpError } from \"@sveltejs/kit\";",
			"import { LoaderCircle } from \"@lucide/svelte\";",
			"",
			"import { ${1:action}${2:Entity} } from \"#lib/remote/${3:entity}/${3:entity}.command.remote\";",
			"import { notifications } from \"#lib/services/notifications.svelte\";",
			"",
			"interface Props {",
			"\t${3:entity}Id: string;",
			"}",
			"",
			"let { ${3:entity}Id }: Props = \\$props();",
			"",
			"let isSubmitting = \\$state(false);",
			"",
			"const handleAction = async () => {",
			"\tif (isSubmitting) return;",
			"",
			"\tisSubmitting = true;",
			"\ttry {",
			"\t\tawait ${1:action}${2:Entity}({ id: ${3:entity}Id });",
			"\t\tnotifications.showToastSuccess(\"¡Acción realizada con éxito!\");",
			"\t} catch (e) {",
			"\t\tif (isHttpError(e)) {",
			"\t\t\tnotifications.showToastError(",
			"\t\t\t\te.body?.message || \"No pudimos completar la acción en este momento.\",",
			"\t\t\t);",
			"\t\t} else {",
			"\t\t\tnotifications.showToastError(",
			"\t\t\t\t\"No se pudo establecer comunicación con el servidor. Si el problema continúa, comuníquese con sistemas.\",",
			"\t\t\t);",
			"\t\t}",
			"\t} finally {",
			"\t\tisSubmitting = false;",
			"\t}",
			"};",
			"</script>",
			"",
			"<button",
			"\ttype=\"button\"",
			"\tdisabled={isSubmitting}",
			"\tonclick={handleAction}",
			">",
			"\t{#if isSubmitting}",
			"\t\t<LoaderCircle size={16} class=\"spinner\" />",
			"\t{:else}",
			"\t\t<span>${4:Ejecutar}</span>",
			"\t{/if}",
			"</button>"
		],
		"description": [
			"[src/lib/components/.../*Button.svelte] Botón Reactivo para Remote Command",
			"- Ejecución directa con spinner de carga y feedback toast de resultado",
			"- Se conecta con: *.command.remote.ts"
		]
	}
}
