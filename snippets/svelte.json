			"\t\t\t\t<div class=\"alert-header\">",
			"\t\t\t\t\t<div class=\"icon-wrapper\">",
			"\t\t\t\t\t\t<TriangleAlert size=\"36\" />",
			"\t\t\t\t\t</div>",
			"\t\t\t\t\t<h2 id=\"confirm-title\" class=\"alert-title\">",
			"\t\t\t\t\t\t{notifications.confirmState.title}",
			"\t\t\t\t\t</h2>",
			"\t\t\t\t</div>",
			"",
			"\t\t\t\t<div class=\"alert-body\">",
			"\t\t\t\t\t<p id=\"confirm-desc\" class=\"alert-message\">",
			"\t\t\t\t\t\t{notifications.confirmState.message}",
			"\t\t\t\t\t</p>",
			"\t\t\t\t</div>",
			"",
			"\t\t\t\t<div class=\"alert-actions confirm-buttons-layout\">",
			"\t\t\t\t\t<button",
			"\t\t\t\t\t\ttype=\"button\"",
			"\t\t\t\t\t\tclass=\"btn-confirm-cancel\"",
			"\t\t\t\t\t\tonclick={() => notifications.resolveConfirm(false)}",
			"\t\t\t\t\t>",
			"\t\t\t\t\t\tCancelar",
			"\t\t\t\t\t</button>",
			"\t\t\t\t\t<button",
			"\t\t\t\t\t\ttype=\"button\"",
