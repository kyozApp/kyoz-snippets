			"\t\t\t\t\t\t{/if}",
			"\t\t\t\t\t</div>",
			"\t\t\t\t\t<h2 id=\"alert-title\" class=\"alert-title\">",
			"\t\t\t\t\t\t{notifications.alert.title}",
			"\t\t\t\t\t</h2>",
			"\t\t\t\t</div>",
			"",
			"\t\t\t\t<div class=\"alert-body\">",
