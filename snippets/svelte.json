			"\t\tbackground-position: 0% 50%;",
			"\t}",
			"}",
			"",
			".sonner-error .sonner-glow {",
			"\tbackground: linear-gradient(",
			"\t\t90deg,",
			"\t\toklch(62% 0.25 35),",
			"\t\toklch(70% 0.22 35),",
			"\t\toklch(62% 0.25 35)",
			"\t);",
